{
  "name": "@weftlabs/sdk",
  "version": "0.26.8",
  "description": "Unified Weft SDK for the Weft API and x402 Facilitator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./facilitator": {
      "import": {
        "types": "./dist/facilitator/index.d.mts",
        "default": "./dist/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/facilitator/index.d.ts",
        "default": "./dist/facilitator/index.js"
      }
    },
    "./facilitator/middleware": {
      "import": {
        "types": "./dist/facilitator/middleware/index.d.mts",
        "default": "./dist/facilitator/middleware/index.mjs"
      },
      "require": {
        "types": "./dist/facilitator/middleware/index.d.ts",
        "default": "./dist/facilitator/middleware/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "format": "prettier --write \"src/**/*.ts\" \"!src/generated/**\" \"examples/*.mjs\" \"../scripts/test-typescript-quickstarts.mjs\" \"../scripts/test-seller-quickstarts.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"!src/generated/**\" \"examples/*.mjs\" \"../scripts/test-typescript-quickstarts.mjs\" \"../scripts/test-seller-quickstarts.mjs\"",
    "hooks:pre-push": "pnpm run lint:check && pnpm run format:check && vitest run",
    "generate": "../scripts/generate-typescript.sh",
    "smoke": "pnpm run build && node ../scripts/weft-smoke.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "weft",
    "x402",
    "payments",
    "micropayments",
    "coinbase",
    "sdk"
  ],
  "author": "Weft Labs",
  "license": "Apache-2.0",
  "homepage": "https://weftlabs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/weftlabs/weft-sdk"
  },
  "peerDependencies": {
    "@x402/core": "^2.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@x402/core": "2.24.0",
    "eslint": "^10.4.1",
    "express": "^5.2.1",
    "fast-check": "^4.8.0",
    "hono": "^4.13.5",
    "prettier": "3.9.6",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
