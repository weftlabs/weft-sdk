  {
    "name": "fetch refused for price before signing is not charged",
    "call": {"method": "fetch", "args": {"request": {"url": "https://m.example/x", "maxCostUsd": "0.05"}, "options": {"idempotencyKey": "k-1"}}},
    "client": {"credential": "wk_test", "baseUrl": "https://api.example"},
    "expectRequest": {
      "method": "POST",
      "path": "/api/v1/fetch",
      "query": {},
      "headers": {"authorization": "Bearer wk_test", "idempotency-key": "k-1"},
      "jsonBody": {"url": "https://m.example/x", "max_cost_usd": "0.05"}
    },
    "response": {"status": 402, "reason": "Payment Required", "headers": {"content-type": "application/json"}, "body": {"error": "EXCEEDED_MAX_COST"}},
    "expectError": {"status": 402, "code": "EXCEEDED_MAX_COST", "message": "Weft API returned HTTP 402", "requestId": null, "retryable": false, "details": {"error": "EXCEEDED_MAX_COST"}, "charge": "none"}
  },
