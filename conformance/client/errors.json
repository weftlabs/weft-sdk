    "response": {
      "status": 404,
      "reason": "Not Found",
      "headers": {"content-type": "application/json"},
      "body": {
        "code": "NOT_FOUND",
        "message": "missing",
        "request_id": "req-flat"
      }
    },
    "expectError": {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "missing",
      "requestId": "req-flat",
      "retryable": false,
      "charge": "none",
      "details": {
        "code": "NOT_FOUND",
        "message": "missing",
        "request_id": "req-flat"
      }
    }
  },
