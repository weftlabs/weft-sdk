[
  {
    "name": "nested error envelope wins over the request id header",
    "call": {"method": "me", "args": {}},
    "client": {"credential": "wk_test", "baseUrl": "https://api.example"},
    "expectRequest": {
      "method": "GET",
      "path": "/api/v1/me",
      "query": {},
      "headers": {"authorization": "Bearer wk_test"}
    },
    "response": {
      "status": 429,
      "reason": "Too Many Requests",
      "headers": {
        "content-type": "application/json",
        "X-Request-Id": "req-header"
      },
      "body": {
        "error": {
          "code": "RATE_LIMITED",
          "message": "slow down",
          "request_id": "req-body"
        }
      }
    },
    "expectError": {
      "status": 429,
      "code": "RATE_LIMITED",
      "message": "slow down",
      "requestId": "req-body",
      "retryable": true,
      "charge": "none",
      "details": {
        "error": {
          "code": "RATE_LIMITED",
          "message": "slow down",
          "request_id": "req-body"
        }
      }
    }
  },
  {
