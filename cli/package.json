{
  "name": "@weftlabs/cli",
  "version": "0.26.1",
  "description": "Command-line client for the Weft buyer runtime",
  "type": "module",
  "bin": {
    "weft": "./bin/weft.mjs"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "scripts/install-skill.mjs",
    "scripts/skill-paths.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm --filter @weftlabs/sdk build",
    "test": "vitest run",
    "pretest:unit": "pnpm --filter @weftlabs/sdk build",
    "test:unit": "vitest run",
    "lint:check": "eslint",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepack": "node scripts/prepare-skill.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "weft",
    "cli",
    "agents",
    "x402"
  ],
  "author": "Weft Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/weftlabs/weft-sdk",
    "directory": "cli"
  },
  "dependencies": {
    "@weftlabs/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^10.4.1",
    "prettier": "3.9.6",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
